<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="microtractor_width" value="0.15"/>
    <xacro:property name="microtractor_heigh" value="0.2"/>
    <xacro:property name="microtractor_length" value="0.5"/>
    

    <link name="base_link"/>

    <joint name="chassis_joint" type="fixed">
        <origin xyz="-0.2 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="chassis_link"/>
    </joint>

    <link name="chassis_link">
        <visual>
        <origin xyz="${microtractor_length/2} 0.0 ${microtractor_heigh/2}"/>
        <!--origin xyz="0.0 0.0 0.0"/-->
            <geometry>
                <box size="${microtractor_length} ${microtractor_width} ${microtractor_heigh}"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="${microtractor_width - 0.03} 0.0 ${microtractor_heigh}" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.015 0.03 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="gps_joint" type="fixed">
        <origin xyz="0.0 0.0 ${microtractor_heigh}"/>
        <parent link="base_link"/>
        <child link="gps_link"/>
    </joint>

    <link name="gps_link">
        <visual>
            <geometry>
                <box size="0.06 0.06 0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <xacro:triangular_track preffix="right" x="0.0" y="${track_width+0.01}" z="-${attack_pinion_center-microtractor_heigh/2}" side="${right}"/>
    <xacro:triangular_track preffix="left" x="0.0" y="-${track_width+0.01}" z="-${attack_pinion_center-microtractor_heigh/2}" side="${left}"/>
</robot>